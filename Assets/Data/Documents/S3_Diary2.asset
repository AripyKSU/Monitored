  m_Name: S3_Diary2
  m_EditorClassIdentifier: Assembly-CSharp::HauntedHouse.Interaction.DocumentDefinition
  backgroundImage: {fileID: 21300000, guid: 5365f90029361ae4cb8dae414889cceb, type: 3}
  bodyText: "\uC624\uB298\uC740 \uC2DD\uB2F9\uC5D0\uC11C \uD63C\uC790 \uBC25\uC744
    \uBA39\uC5C8\uB2E4.\r\n\uC0AC\uB78C \uC5C6\uB294 \uAD6C\uC11D\uC5D0 \uC549\uC558\uB294\uB370\uB3C4
    \uB610 \uB204\uAC00 \uB098\uB97C \uBCF4\uACE0 \uC788\uC5C8\uB2E4.\r\n\r\n\uC74C\uC2DD\uC744
    \uAC00\uC838\uB2E4\uC900 \uB188\uB3C4 \uC774\uC0C1\uD588\uB2E4.\r\n\uC811\uC2DC\uB97C
    \uB0B4\uB824\uB193\uACE0\uB294 \uD55C\uCC38\uC774\uB098 \uB0B4 \uC5BC\uAD74\uC744
    \uCCD0\uB2E4\uBD24\uB2E4.\r\n\uB0B4\uAC00 \uC65C \uBCF4\uB0D0\uACE0 \uBB3B\uC790
    \uC544\uBB34 \uB9D0\uB3C4 \uC5C6\uC774 \uAC00\uBC84\uB838\uB2E4.\r\n\r\n\uB2E4
    \uB611\uAC19\uC544.\r\n\uBAA8\uB974\uB294 \uCC99\uD558\uBA74\uC11C \uACC4\uC18D
    \uBCF4\uACE0 \uC788\uB2E4.\r\n\r\n\uBC25\uC744 \uBA39\uB294 \uB3D9\uC548\uC5D0\uB3C4
    \uC2DC\uC120\uC774 \uB290\uAEF4\uC84C\uB2E4.\r\n\uACE0\uAC1C\uB97C \uB4E4\uBA74
    \uC544\uBB34\uB3C4 \uC548 \uBCF4\uB294 \uCC99\uD55C\uB2E4.\r\n\r\n\uB0B4\uAC00
    \uBAA8\uB97C \uC904 \uC544\uB098.\r\n\r\n\uADF8\uB807\uAC8C \uCCD0\uB2E4\uBCF4\uC9C0
    \uB9C8.\r\n\uACC4\uC18D \uBCF4\uACE0 \uC788\uC73C\uBA74 \uAC00\uB9CC\uB450\uC9C0
    \uC54A\uC744 \uAC70\uC57C.\r\n\r\n(\uC544\uB798\uC5D0\uB294 \uAC19\uC740 \uBB38\uC7A5\uC774
    \uC5EC\uB7EC \uBC88 \uB367\uC50C\uC6CC\uC838 \uC788\uB2E4.)"
