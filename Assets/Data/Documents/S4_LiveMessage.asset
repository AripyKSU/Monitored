  m_Script: {fileID: 11500000, guid: 29fd12636ab9d1b40bac2122e57845c0, type: 3}
  m_Name: S4_LiveMessage
  m_EditorClassIdentifier: Assembly-CSharp::HauntedHouse.Interaction.DocumentDefinition
  backgroundImage: {fileID: 21300000, guid: 5365f90029361ae4cb8dae414889cceb, type: 3}
  bodyText: "\uC774 \uBCD1\uC6D0\uC5D0 \uB0A9\uCE58\uB418\uC5B4 \uC77C\uC5B4\uB098\uACE0,
    \uBB34\uC804\uAE30\uC5D0\uC11C \uC2DC\uD0A4\uB294 \uB300\uB85C \uC6C0\uC9C1\uC774\uBA70
    \uAC74\uBB3C \uAD6C\uC870\uB97C \uD30C\uC545\uD588\uB2E4.\n\r\n\uD558\uC9C0\uB9CC
    \uC5B4\uB514\uC120\uAC00 \uB098\uB97C \uC9C0\uCF1C\uBCF4\uBA70 \uB9D0\uC744 \uAC70\uB294
    \uB188\uC744 \uC5B4\uB5BB\uAC8C \uBBFF\uC73C\uB77C\uB294 \uAC70\uC9C0.\r\n\uB0B4\uAC00
    \uC5B4\uB514\uC5D0 \uC788\uB294\uC9C0, \uBB58 \uD558\uACE0 \uC788\uB294\uC9C0
    \uB140\uC11D\uC740 \uB108\uBB34 \uC798 \uC54C\uACE0 \uC788\uB2E4.\n\r\n\uADF8\uB188
    \uB9D0\uB300\uB85C \uC6C0\uC9C1\uC774\uC9C4 \uC54A\uC744\uAC70\uC57C, \uB0B4\uAC00
    \uC9C1\uC811 \uD0C8\uCD9C\uD560 \uBC29\uBC95\uC744 \uCC3E\uACA0\uC5B4."
