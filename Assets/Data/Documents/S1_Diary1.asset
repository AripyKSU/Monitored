  m_EditorClassIdentifier: Assembly-CSharp::HauntedHouse.Interaction.DocumentDefinition
  backgroundImage: {fileID: 21300000, guid: 5365f90029361ae4cb8dae414889cceb, type: 3}
  bodyText: "\uC774 \uBCD1\uC2E4\uC5D0 \uB4E4\uC5B4\uC628 \uC9C0\uB3C4 \uBC8C\uC368
    \uD55C \uB2EC\uC9F8\uB2E4.\r\n\uC65C \uC774 \uBE4C\uC5B4\uBA39\uC744 \uC758\uC0AC\uB294
    \uB0B4 \uB9D0\uC744 \uBBFF\uC9C0 \uC54A\uB294 \uAC70\uC9C0?\r\n\r\n\uBD84\uBA85
    \uADF8 \uB140\uC11D\uC774 \uB098\uB97C \uBCF4\uACE0 \uC788\uC5C8\uB2E4.\r\n\uC9C0\uAE08\uB3C4
    \uC785\uB9C9\uC74C\uC744 \uD558\uB824\uACE0 \uAE30\uD68C\uB9CC \uB178\uB9AC\uACE0
    \uC788\uC744 \uAC70\uB2E4.\r\n\uAC04\uD638\uC0AC\uB3C4 \uD55C\uD328\uB2E4. \uC5B4\uC81C\uB294
    \uC774\uC0C1\uD55C \uC8FC\uC0AC\uAE4C\uC9C0 \uB193\uC73C\uB824\uACE0 \uD588\uB2E4.\r\n\r\n\uBCD1\uC2E4\uC744
    \uC62E\uACA8 \uB2EC\uB77C\uACE0 \uBA87 \uBC88\uC774\uB098 \uB9D0\uD588\uB294\uB370
    \uC544\uBB34\uB3C4 \uB4E3\uC9C0 \uC54A\uB294\uB2E4.\r\n\uC0C8\uB85C \uB4E4\uC5B4\uC628
    \uD658\uC790\uB3C4 \uACC4\uC18D \uB098\uB97C \uCCD0\uB2E4\uBCF8\uB2E4. \uC800
    \uB140\uC11D\uB3C4 \uD55C\uD328\uC57C.\r\n\r\n\uC81C\uBC1C \uB098\uB97C \uC880
    \uB0B4\uBC84\uB824 \uB46C.\r\n\uC544\uB2C8, \uD63C\uC790 \uC788\uC73C\uBA74 \uB354
    \uC798 \uBCF4\uC774\uACA0\uC9C0.\r\n\r\n\uADF8\uB9CC \uBD10.\r\n\uB098\uB97C
    \uBCF4\uC9C0 \uB9C8.\r\n\r\n(\uC774\uD6C4\uC758 \uAE00\uC528\uB294 \uC2EC\uD558\uAC8C
    \uBC88\uC838 \uC77D\uC744 \uC218 \uC5C6\uB2E4.)"
