MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c7f4edb2bdbad3c4d95582e6752f8fac, type: 3}
  m_Name: S1_IntroRadioDialogue
  m_EditorClassIdentifier: Assembly-CSharp::HauntedHouse.Dialogue.DialogueSequence
  pauseGame: 1
  autoAdvanceDelay: 0
  lines:
  - speaker: 0
    text: "\uC774\uBD10, \uB4E4\uB824? \uB4E4\uB9AC\uBA74 \uB300\uB2F5\uD574"
  - speaker: 1
    text: "\uBB34\uC804\uAE30? \uB204..\uB204\uAD6C\uC138\uC694?"
  - speaker: 0
    text: "\uC815\uC2E0\uC744 \uCC28\uB838\uAD70. \uC5EC\uAE30\uB294 \uC5B4\uCA4C\uB2E4
      \uB4E4\uC5B4\uC628\uAC70\uC57C?"
  - speaker: 0
    text: "\uC774\uB7F0 \uACF3\uC5D0 \uC5EC\uC790 \uD63C\uC790 \uB4E4\uC5B4\uC624\uBA74
      \uC704\uD5D8\uD574."
  - speaker: 1
    text: "\uC804 \uC5EC\uAE30\uAC00 \uC5B4\uB518\uC9C0\uB3C4 \uBAA8\uB974\uB294\uAC78\uC694.
      \uC77C\uC5B4\uB098\uBCF4\uB2C8 \uC5EC\uAE30\uC600\uC5B4\uC694."
  - speaker: 0
    text: "\uC774\uACF3\uC740 \uD3D0\uBCD1\uC6D0\uC774\uC57C. \uADF8\uB9AC\uACE0
      \uAC01\uC885 \uBC94\uC8C4\uC790\uB4E4\uC774 \uC774\uACF3\uC744 \uAC70\uCC98\uB85C
      \uC0BC\uACE0\uC788\uB2E4\uACE0."
  - speaker: 0
    text: "\uB0B4\uAC00 \uB098\uAC00\uB294 \uAE38\uC744 \uC54C\uB824\uC8FC\uC9C0.
      \uB098\uB9CC \uBBFF\uACE0 \uBC16\uC73C\uB85C \uB098\uAC00."
