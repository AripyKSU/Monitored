  lines:
  - speaker: 0
    text: "\uC911\uC559 \uBCF5\uB3C4\uC758 \uC154\uD130\uAC00 \uB0B4\uB824\uAC00\uC788\uAD70.
      \uC774\uB300\uB85C\uB294 \uB098\uAC08 \uC218 \uC5C6\uACA0\uC5B4."
  - speaker: 1
    text: "\uC5B4\uB5BB\uAC8C \uD574\uC57C\uD558\uC8E0?"
  - speaker: 0
    text: "\uAE30\uACC4\uC2E4\uC5D0 \uAC00\uBA74 \uC154\uD130\uB97C \uC81C\uC5B4\uD560
      \uC218 \uC788\uB294 \uBA38\uC2E0\uC774 \uC788\uC5B4.\n\uB2E4\uB9CC \uAC74\uBB3C
      \uC804\uB825\uC774 \uB098\uAC00\uC11C \uC791\uB3D9\uD560\uC9C0\uB294 \uBAA8\uB974\uACA0\uAD70.
      \uC624\uB978\uCABD \uBCF5\uB3C4\uC57C."
