.endingCreditsRoot {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 5, 9, 0.96);
}

.creditsCard {
    width: 680px;
    min-height: 420px;
    padding-left: 56px;
    padding-right: 56px;
    padding-top: 48px;
    padding-bottom: 48px;
    align-items: center;
    background-color: rgba(18, 23, 33, 0.98);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.endingHeading {
    font-size: 18px;
    color: rgb(166, 184, 212);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.endingName {
    margin-top: 18px;
    font-size: 42px;
    color: rgb(242, 199, 89);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.creditsDivider {
    width: 420px;
    height: 2px;
    margin-top: 30px;
    margin-bottom: 30px;
    background-color: rgba(166, 184, 212, 0.35);
}

.productionInfo {
    font-size: 20px;
    color: rgb(224, 230, 242);
    white-space: normal;
    -unity-text-align: middle-center;
}

.returnToTitleButton {
    width: 300px;
    height: 58px;
    margin-top: 42px;
    color: rgb(18, 23, 33);
    background-color: rgb(215, 177, 75);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.returnToTitleButton:hover {
    background-color: rgb(242, 209, 111);
}

.returnToTitleButton:disabled {
    color: rgb(128, 132, 140);
    background-color: rgb(72, 76, 86);
}
